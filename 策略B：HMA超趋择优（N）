def _notion_headers():
    return {
        "Authorization": f"Bearer {NOTION_TOKEN}",
        "Notion-Version": NOTION_VERSION,
        "Content-Type": "application/json"
    }


def _fmt_dt(dt):
    """datetime/date/pd.Timestamp -> 'YYYY-MM-DD'"""
    try:
        return dt.strftime("%Y-%m-%d")
    except Exception:
        return str(dt)


def _notion_is_active():
    """实盘/模拟下才写入 Notion，回测不写。"""
    if not NOTION_ENABLE:
        return False
    if IS_BACKTEST:
        return False
    return True


def init_notion_state(context):
    """初始化 Notion 状态，在 initialize 里调用"""
    if not hasattr(context, "notion_trade_state"):
        # code -> {page_id, buy_time, buy_price}
        context.notion_trade_state = {}
    if not hasattr(context, "notion_name_map"):
        # code -> '中文名(代码)'
        context.notion_name_map = {}
    if not hasattr(context, "pending_buys"):
        # code -> {signal_date}
        context.pending_buys = {}


def _get_display_name(context, code):
    """
    获取用于写入 Notion 的展示名：中文名称 + 代码，例如：'容大感光(300576.SZ)'
    优先从 context.data 里的 sec_name/name/instrument_name 中获取。
    找不到就直接用代码。
    """
    try:
        name_map = getattr(context, "notion_name_map", {})
        if code in name_map:
            return name_map[code]

        display = code
        try:
            df = getattr(context, "data", None)
            if df is not None and "instrument" in df.columns:
                row = df[df["instrument"] == code].head(1)
                if len(row) > 0:
                    name = None
                    for col in ["sec_name", "name", "instrument_name"]:
                        if col in row.columns:
                            val = row.iloc[0][col]
                            if isinstance(val, str) and val.strip():
                                name = val.strip()
                                break
                    if name:
                        display = f"{name}({code})"
        except Exception as e:
            print("获取标的中文名异常：", e)

        context.notion_name_map[code] = display
        return display
    except Exception as e:
        print("get_display_name 异常：", e)
        return code


def notion_on_buy(context, code, signal_date, price):
    """
    新开仓波段：
      - 持有时间.start = 买入信号日 T（收盘选出）
      - 自选价格 = T+1 日开盘价（实际执行价）
      - 记录到 notion_trade_state 里，用于后续卖出计算涨幅
    """
    if not _notion_is_active():
        return

    init_notion_state(context)

    # 已存在记录则不重复写（防止重复调用）
    if code in context.notion_trade_state:
        return

    buy_time_str = _fmt_dt(signal_date)  # 信号日 T
    year_str = str(signal_date.year)
    display_name = _get_display_name(context, code)
    price_num = float(price)

    payload = {
        "parent": {"database_id": NOTION_DATABASE_ID},
        "properties": {
            "标的": {
                "title": [
                    {"text": {"content": display_name}}
                ]
            },
            "持有时间": {
                "date": {
                    "start": buy_time_str,
                    "end": None
                }
            },
            "涨幅": {
                "number": 0
            },
            "自选价格": {           # 数字类型，记录 T+1 开盘价
                "number": price_num
            },
            "平台": {
                "multi_select": [
                    {"name": "BigQuant"}
                ]
            },
            "策略": {
                "select": {"name": STRATEGY_NAME}
            },
            "年份": {
                "select": {"name": year_str}
            }
        }
    }

    try:
        res = requests.post(
            "https://api.notion.com/v1/pages",
            headers=_notion_headers(),
            data=json.dumps(payload),
            timeout=5
        )
        data = res.json()
        page_id = data.get("id")
        if not page_id:
            print("Notion 创建页面失败：", data)
            return

        context.notion_trade_state[code] = {
            "page_id": page_id,
            "buy_time": buy_time_str,
            "buy_price": price_num
        }
        print(
            f"[Notion] 新建波段(信号)：{display_name}, "
            f"买入信号日={buy_time_str}, 自选价格(开盘)={price_num}, 策略={STRATEGY_NAME}"
        )
    except Exception as e:
        print("Notion 买入记录异常：", e)


def notion_on_sell(context, code, time_obj, price):
    """
    平仓信号：结束当前波段，在 T 日收盘信号当日写完。
      - 持有时间：start=买入信号日 end=卖出信号日
      - 涨幅：用 卖出信号日收盘价 / 买入价(T+1开盘) 计算
      - 年份：卖出信号年份
    """
    if not _notion_is_active():
        return

    if not hasattr(context, "notion_trade_state"):
        return

    state = context.notion_trade_state.get(code)
    if not state:
        print(f"Notion 未找到 {code} 的买入记录，无法更新卖出信息")
        return

    buy_price = float(state["buy_price"])
    sell_price = float(price)
    pct_decimal = round((sell_price / buy_price - 1.0), 4)
    sell_time_str = _fmt_dt(time_obj)
    year_str = str(time_obj.year)
    display_name = _get_display_name(context, code)

    page_id = state["page_id"]

    payload = {
        "properties": {
            "持有时间": {
                "date": {
                    "start": state["buy_time"],
                    "end": sell_time_str
                }
            },
            "涨幅": {
                "number": pct_decimal
            },
            "年份": {
                "select": {"name": year_str}
            }
        }
    }

    try:
        url = f"https://api.notion.com/v1/pages/{page_id}"
        res = requests.patch(
            url,
            headers=_notion_headers(),
            data=json.dumps(payload),
            timeout=5
        )
        data = res.json()
        if data.get("object") != "page":
            print("Notion 卖出更新失败：", data)
        else:
            print(
                f"[Notion] 完成波段(信号)：{display_name}, "
                f"卖出信号日={sell_time_str}, 参考涨幅={pct_decimal*100:.2f}%, 年份={year_str}"
            )
        context.notion_trade_state.pop(code, None)
    except Exception as e:
        print("Notion 卖出记录异常：", e)


