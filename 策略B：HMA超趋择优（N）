# @param(id="m4", name="initialize")
def m4_initialize_bigquant_run(context):
    from bigtrader.finance.commission import PerOrder

    # 手续费设置（可按需调整）
    context.set_commission(PerOrder(buy_cost=0.0003, sell_cost=0.0013, min_cost=5))

    # 组合与规则参数
    context.max_hold = 6                  # 最大持仓数
    context.min_hold_decisions = 2        # 最少持有“收盘决策次数”

    # 状态变量
    context.hold_decisions = {}           # instrument -> 已经历的“收盘决策次数”
    context.hma_up = {}                   # instrument -> HMA趋势方向(True=多头/False=非多头)

    # Notion 状态
    init_notion_state(context)

    # —— 仅用于测试：回测首日跑一次 Notion 写入 ——
    if RUN_NOTION_TEST_ONCE:
        print("====== 开始执行 Notion 测试写入 test_notion_push() ======")
        test_notion_push()
        print("====== Notion 测试写入结束，请到表中确认 TEST_CODE ======")


