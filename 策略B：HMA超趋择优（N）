# ======== Notion 配置 ========
NOTION_TOKEN = "ntn_占位"
NOTION_DATABASE_ID = "2be4a0b3997080ac9fdfe1c439d30887"
NOTION_VERSION = "2022-06-28"

# —— 开关控制 ——
NOTION_ENABLE = True          # 总开关
IS_BACKTEST = False           # 回测=True；实盘/模拟改 False
RUN_NOTION_TEST_ONCE = False  # 回测首日跑一次 test_notion_push()
