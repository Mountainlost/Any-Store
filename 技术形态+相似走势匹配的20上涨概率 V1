# -*- coding: utf-8 -*-
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from jqdata import *
from datetime import datetime, timedelta

# === 形态特征字段 ===
SHAPE_FEATURE_COLS = [
    'ma_5', 'ma_10', 'ma_20',
    'price_above_ma20',
    'atr14_pct', 'vol_ratio10', 'vol_ratio20',
    'big_bull', 'break_high20'
]

# ------------------------------------------------
# 代码识别：支持 300750 / '300750' / '300750.SZ'
# ------------------------------------------------
def auto_detect_code(code_like):
    """
    Research 环境可用：智能识别股票代码
    输入可以是：300750、'300750'、'300750.SZ'
    """
    s = str(code_like).strip()

    # 1) 已经带市场后缀的
    if "." in s:
        return s.upper()

    # 2) 如果是纯数字（常见）
    if s.isdigit() and len(s) == 6:
        # 深市规则
        if s.startswith(("0", "3")):
            return s + ".XSHE"
        # 沪市规则
        elif s.startswith("6"):
            return s + ".XSHG"
        else:
            return s + ".XSHG"

    raise ValueError(f"无法识别股票代码：{code_like}")

# ------------------------------------------------
# 关键函数：为单只股票计算形态因子
# ------------------------------------------------
def compute_shape_factors_for_stock(code, start_date='2010-01-01', end_date=None):
    """
    返回一个 DataFrame，至少包含：
    - date, open, high, low, close, volume
    - SHAPE_FEATURE_COLS 中列出的所有字段
    """
    code = auto_detect_code(code)

    if end_date is None:
        end_date = datetime.today().strftime('%Y-%m-%d')

    df = get_price(code, start_date=start_date, end_date=end_date, fq='pre')
    if (df is None) or df.empty:
        return pd.DataFrame()

    # index 转为列
    df = df.reset_index()
    if 'index' in df.columns:
        df = df.rename(columns={'index': 'date'})
    elif 'time' in df.columns:
        df = df.rename(columns={'time': 'date'})

    # ========== 均线 ==========
    df['ma_5'] = df['close'].rolling(5).mean()
    df['ma_10'] = df['close'].rolling(10).mean()
    df['ma_20'] = df['close'].rolling(20).mean()

    # 价格是否在 MA20 之上
    df['price_above_ma20'] = (df['close'] > df['ma_20']).astype(int)

    # ========== ATR14 & ATR14_pct ==========
    df['prev_close'] = df['close'].shift(1)
    h_l = df['high'] - df['low']
    h_pc = (df['high'] - df['prev_close']).abs()
    l_pc = (df['low'] - df['prev_close']).abs()
    df['tr'] = pd.concat([h_l, h_pc, l_pc], axis=1).max(axis=1)
    df['atr14'] = df['tr'].rolling(14).mean()
    df['atr14_pct'] = df['atr14'] / df['close']

    # ========== 成交量放大倍率 ==========
    df['vol_ma10'] = df['volume'].rolling(10).mean()
    df['vol_ma20'] = df['volume'].rolling(20).mean()
    df['vol_ratio10'] = df['volume'] / df['vol_ma10']
    df['vol_ratio20'] = df['volume'] / df['vol_ma20']

    # ========== 大阳线标记 ==========
    df['big_bull'] = ((df['close'] / df['open'] - 1) >= 0.07).astype(int)

    # ========== 突破 20 日新高 ==========
    df['high20_prev'] = df['high'].rolling(20).max().shift(1)
    df['break_high20'] = (df['close'] > df['high20_prev']).astype(int)

    # 去掉特征中有 NaN 的预热期
    df = df.dropna(subset=SHAPE_FEATURE_COLS).reset_index(drop=True)

    return df

# ------------------------------------------------
# 形态相似度 + 未来收益统计
# ------------------------------------------------
def shape_winrate(code, as_of_date=None,
                  start_date='2010-01-01',
                  horizon=20, neighbor_count=200):

    code = auto_detect_code(code)

    # 1) 拿尽量完整的因子数据（先不过滤 as_of_date，方便后面画路径）
    df = compute_shape_factors_for_stock(code, start_date, None)
    if df.empty:
        raise ValueError("没有拿到任何价格数据，请检查代码或起始日期")

    df = df.sort_values('date').reset_index(drop=True)

    # ===== 2) 处理 as_of_date（评估日期）=====
    if as_of_date is None:
        # 自动取最后一个交易日的前一天（留出一天作为“未来”的空间）
        if len(df) < 2:
            raise ValueError("数据量不足，无法获取前一天")
        as_of_date = df['date'].iloc[-2]
    else:
        as_of_date = pd.to_datetime(as_of_date)

    # 只保留 as_of_date 之前的全部数据（含 as_of_date）
    df = df[df['date'] <= as_of_date].copy()
    if df.empty:
        raise ValueError("as_of_date 之前没有任何数据")

    # 重新排序 & 编号（后面用 idx 定位未来路径）
    df = df.sort_values('date').reset_index(drop=True)
    df['idx'] = np.arange(len(df))

    # 3) 计算未来 horizon 日收益（next_ret）
    df['next_ret'] = df['close'].shift(-horizon) / df['close'] - 1

    # 4) today_row：评估这一天的 K 线（就是最后一行）
    today_row = df.iloc[-1]
    today_vec = today_row[SHAPE_FEATURE_COLS].values.astype(float)

    # 5) 历史样本：只用 today_row 之前，且 next_ret 有值
    hist_df = df[df['date'] < today_row['date']].copy()
    hist_df = hist_df.dropna(subset=['next_ret']).reset_index(drop=True)
    if hist_df.empty:
        raise ValueError("没有足够的历史用来匹配相似形态")

    # 6) 欧式距离
    feats_mat = hist_df[SHAPE_FEATURE_COLS].values.astype(float)   # (N, K)
    diff = feats_mat - today_vec.reshape(1, -1)                    # (N, K)
    dist = (diff ** 2).sum(axis=1) ** 0.5                          # (N,)
    hist_df['dist'] = dist

    neighbors = hist_df.sort_values('dist').head(neighbor_count)

    # 7) 统计未来 horizon 日收益分布
    winrate = (neighbors['next_ret'] > 0).mean()
    avg_ret = neighbors['next_ret'].mean()
    p05 = neighbors['next_ret'].quantile(0.05)
    p50 = neighbors['next_ret'].quantile(0.50)
    p95 = neighbors['next_ret'].quantile(0.95)

    print("======== 形态匹配结果（{}） ========".format(code))
    print("评估日期:", today_row['date'].date())
    print("可用历史样本:", len(hist_df))
    print("匹配邻居数量:", len(neighbors))
    print("未来 {} 日胜率: {:.2%}".format(horizon, winrate))
    print("未来 {} 日均值收益: {:.2%}".format(horizon, avg_ret))
    print("未来 {} 日收益 [5%, 50%, 95%]: {:.2%}, {:.2%}, {:.2%}".format(
        horizon, p05, p50, p95))

    return {
        'today_row': today_row,
        'neighbors': neighbors,
        'df_all': df,   # 用于后面拼接过去/未来路径
        'stats': {
            'winrate': winrate,
            'avg_ret': avg_ret,
            'p05': p05,
            'p50': p50,
            'p95': p95
        }
    }

# ------------------------------------------------
# 辅助画图：收益分布、形态距离 vs 收益
# ------------------------------------------------
def plot_return_distribution(res, horizon=20):
    neighbors = res['neighbors']
    ret = neighbors['next_ret']

    plt.figure(figsize=(8, 5))
    plt.hist(ret, bins=30, alpha=0.7)
    plt.axvline(ret.mean(), linestyle='--', label='均值')
    plt.title("未来 {} 日收益分布（形态相似样本）".format(horizon))
    plt.legend()
    plt.show()

def plot_neighbors_scatter(res, horizon=20):
    neighbors = res['neighbors']

    plt.figure(figsize=(8, 5))
    plt.scatter(neighbors['dist'], neighbors['next_ret'], alpha=0.6)
    plt.axhline(0, linestyle='--')
    plt.xlabel("形态距离")
    plt.ylabel("未来 {} 日收益".format(horizon))
    plt.title("形态相似度 vs 收益")
    plt.show()

# ------------------------------------------------
# 走势对比 + 未来概率带（绿线 + 黑/灰/浅灰）
# ------------------------------------------------
def plot_price_paths(code, res,
                     horizon=20,
                     pre_days=60,
                     max_neighbors_for_band=None,
                     line_path_count=20):
    """
    绿线：当前标的过去 pre_days 个交易日（归一到今天=1）
    浅灰 / 深灰 + 黑线：未来区间 5%-95% / 25%-75% / 中位数
    红线：代表性邻居路径（数量= line_path_count）：
        - 上涨 / 下跌条数按历史邻居“20日后涨跌比例”来分配
        - 每组内部按终点收益分位数均匀抽样
    """

    df_all = res['df_all']
    today_row = res['today_row']
    neighbors = res['neighbors']

    if max_neighbors_for_band is not None:
        neighbors = neighbors.head(max_neighbors_for_band)

    # ---------- 构造“过去”路径（绿线） ----------
    today_idx = int(today_row['idx'])
    start_idx = max(0, today_idx - pre_days)
    df_past = df_all.iloc[start_idx: today_idx + 1].copy()
    past_close = df_past['close'].values
    if len(past_close) < 2:
        print("历史数据太短，无法绘制过去走势")
        return

    # 今天=1 归一化
    past_norm = past_close / past_close[-1]
    past_len = len(past_norm)

    # ---------- 构造邻居未来路径矩阵 ----------
    future_paths = []
    for _, row in neighbors.iterrows():
        idx0 = int(row['idx'])
        future_slice = df_all.iloc[idx0: idx0 + horizon + 1]
        if len(future_slice) < horizon + 1:
            continue
        prices = future_slice['close'].values
        prices_norm = prices / prices[0]       # 邻居当日=1
        future_paths.append(prices_norm[1:])   # 未来 1~horizon

    if not future_paths:
        print("未来路径不足，无法绘制概率带")
        return

    future_mat = np.vstack(future_paths)       # (n_neighbors, horizon)
    future_len = future_mat.shape[1]

    # ---------- 概率带（先算未来，然后在前面补一个“今天=1”） ----------
    p05 = np.nanpercentile(future_mat, 5, axis=0)
    p25 = np.nanpercentile(future_mat, 25, axis=0)
    p50 = np.nanpercentile(future_mat, 50, axis=0)
    p75 = np.nanpercentile(future_mat, 75, axis=0)
    p95 = np.nanpercentile(future_mat, 95, axis=0)

    p05_full = np.concatenate([[1.0], p05])
    p25_full = np.concatenate([[1.0], p25])
    p50_full = np.concatenate([[1.0], p50])
    p75_full = np.concatenate([[1.0], p75])
    p95_full = np.concatenate([[1.0], p95])

    # ---------- 相对时间轴 ----------
    x_past = np.linspace(-1.0, 0.0, past_len)
    x_future_full = np.linspace(0.0, 2.0, future_len + 1)   # 含 t=0

    fig, ax = plt.subplots(figsize=(10, 5))
    ax.set_facecolor("#F9F9F9")

    # 1）历史走势（绿线）
    ax.plot(x_past, past_norm, color="green", linewidth=2,
            label="历史走势（当前标的）")

    # 2）未来概率带（从“今天=1”开始连续）
    ax.fill_between(x_future_full, p05_full, p95_full,
                    color="lightgray", alpha=0.3,
                    label="未来区间 5%-95%")
    ax.fill_between(x_future_full, p25_full, p75_full,
                    color="gray", alpha=0.5,
                    label="未来区间 25%-75%")
    ax.plot(x_future_full, p50_full, color="black", linewidth=2,
            label="未来中位数路径")

    # 3）代表性的红色路径：上涨/下跌条数按比例分配
    if line_path_count > 0:
        # 以终点价格判断涨跌（>1 为涨）
        end_price = future_mat[:, -1]
        end_ret = end_price - 1.0
        up_mask = end_ret >= 0
        down_mask = ~up_mask

        up_count_all = up_mask.sum()
        down_count_all = down_mask.sum()
        total_all = len(end_ret)

        if total_all == 0:
            print("没有可用邻居路径")
        else:
            # 历史上涨比例
            up_ratio = up_count_all / float(total_all)

            # 分配条数
            up_lines = int(round(up_ratio * line_path_count))
            up_lines = min(up_lines, up_count_all)
            up_lines = max(up_lines, 0)

            down_lines = line_path_count - up_lines
            down_lines = min(down_lines, down_count_all)
            down_lines = max(down_lines, 0)

            # 如果某一类不足，剩余从另一类补
            remain = line_path_count - (up_lines + down_lines)
            if remain > 0:
                if up_count_all - up_lines >= remain:
                    up_lines += remain
                elif down_count_all - down_lines >= remain:
                    down_lines += remain

            def draw_group(mask, n_lines):
                if n_lines <= 0 or mask.sum() == 0:
                    return
                group_mat = future_mat[mask]
                group_ret = end_ret[mask]
                # 在该组内部按分位数抽样
                qs = np.linspace(0, 100, n_lines + 2)[1:-1]
                used_idx = set()
                for q in qs:
                    target = np.percentile(group_ret, q)
                    idx_local = int(np.argmin(np.abs(group_ret - target)))
                    shift = 0
                    # 尽量避免重复
                    while idx_local in used_idx and shift < len(group_ret):
                        idx_local = (idx_local + 1) % len(group_ret)
                        shift += 1
                    used_idx.add(idx_local)
                    y_full = np.concatenate([[1.0], group_mat[idx_local]])
                    ax.plot(x_future_full, y_full,
                            color="red", alpha=0.7, linewidth=1)

            # 先画上涨组，再画下跌组（都用红色，只是数量不同比例）
            draw_group(up_mask, up_lines)
            draw_group(down_mask, down_lines)

    # 4）今天的位置
    ax.axvline(0, color="black", linewidth=1, linestyle="--")

    # ---------- 外观 ----------
    title = "走势对比与未来区间 ({})".format(code)
    ax.set_title(title)

    ymin = np.nanmin(np.concatenate([past_norm, p05_full]))
    ymax = np.nanmax(np.concatenate([past_norm, p95_full]))
    ax.set_ylim(ymin * 0.95, ymax * 1.05)

    ax.set_xticks([])
    ax.set_xlabel("")

    ax.legend(loc="upper left", frameon=False)

    ymin_, ymax_ = ax.get_ylim()
    ax.text(-0.5, ymax_, "过去",
            ha="center", va="bottom", color="green")
    ax.text(1.0, ymax_, "未来{}天".format(future_len),
            ha="center", va="bottom", color="black")

    plt.tight_layout()
    plt.show()




# ------------------------------------------------
# 总入口函数
# ------------------------------------------------
def analyze_shape(code_like,
                  as_of_date=None,
                  start_date='2010-01-01',
                  horizon=20,
                  neighbor_count=200,
                  pre_days=60,
                  max_neighbors_for_band=None,
                  line_path_count=20):

    code = auto_detect_code(code_like)
    print("识别股票代码:", code)

    res = shape_winrate(
        code=code,
        as_of_date=as_of_date,
        start_date=start_date,
        horizon=horizon,
        neighbor_count=neighbor_count
    )

    plot_return_distribution(res, horizon)
    plot_neighbors_scatter(res, horizon)
    plot_price_paths(code, res,
                     horizon=horizon,
                     pre_days=pre_days,
                     max_neighbors_for_band=max_neighbors_for_band,
                     line_path_count=line_path_count)

    return res

