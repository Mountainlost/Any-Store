# 6. 图表绘制（Notebook展示）
# ==============================================================================

def plot_heatmap(width_df, aux_df):
    """绘制主（宽度矩阵）与副（辅助指标）热力图组合，仅在 Notebook 展示。"""
    try:
        plt.style.use(PLOT_STYLE)
    except Exception:
        pass
    plt.rcParams['font.sans-serif'] = ['SimHei']
    plt.rcParams['axes.unicode_minus'] = False

    # 根据行数动态计算高度
    num_rows = len(width_df)
    fig_height = FIG_BASE_HEIGHT + num_rows * FIG_PER_ROW_HEIGHT
    fig_height = min(fig_height, FIG_MAX_HEIGHT)

    fig, (ax0, ax1) = plt.subplots(
        1, 2, figsize=(15, fig_height), sharey=True,
        gridspec_kw={'width_ratios': [25, 4], 'wspace': 0.05},
        constrained_layout=True
    )

    # 按日期倒序显示（最近在上方），右侧辅助同步索引
    plot_width = width_df.sort_index(ascending=False).copy()
    plot_aux = aux_df.loc[plot_width.index].copy()

    plot_width.index = pd.to_datetime(plot_width.index).strftime('%Y-%m-%d')
    plot_aux.index = pd.to_datetime(plot_aux.index).strftime('%Y-%m-%d')

    # 列名英文化：组列 -> G1..G20；副图中文列 -> 英文列
    width_rename = {f'组{i+1}': f'G{i+1}' for i in range(NUM_GROUPS)}
    plot_width.rename(columns=width_rename, inplace=True)
    plot_aux.rename(columns=AUX_COL_RENAME, inplace=True)

    sns.heatmap(plot_width, annot=ANNOTATE_CELLS, fmt=ANNOT_FMT,
                cmap=HEATMAP_CMAP, ax=ax0, cbar=False, linewidths=HEATMAP_GRID_LINEWIDTHS)
    ax0.set_title(PLOT_TITLE_MAIN, fontsize=20, pad=40)
    ax0.set_xlabel(PLOT_XLABEL, fontsize=14)
    ax0.set_ylabel(PLOT_YLABEL, fontsize=14)
    ax0.xaxis.tick_top(); ax0.xaxis.set_label_position('top')
    for label in ax0.get_yticklabels():
        label.set_rotation(0)
        label.set_ha('right')
        label.set_fontweight('bold')
    for label in ax0.get_xticklabels():
        label.set_fontweight('bold')

    sns.heatmap(plot_aux, annot=ANNOTATE_CELLS, fmt=ANNOT_FMT,
                cmap=HEATMAP_CMAP, ax=ax1, cbar=False, linewidths=HEATMAP_GRID_LINEWIDTHS)
    ax1.set_title(PLOT_TITLE_AUX, fontsize=20, pad=40)
    ax1.set_xlabel('', fontsize=14)
    ax1.xaxis.tick_top(); ax1.xaxis.set_label_position('top')
    plt.setp(ax1.get_yticklabels(), visible=False)
    for label in ax1.get_xticklabels():
        label.set_fontweight('bold')

    # Notebook展示
    plt.show()


# ==============================================================================
# 7. 主流程
# ==============================================================================

def main():
    """主流程：依次获取数据、计算指标并绘图展示。"""
    # 1) 股票池与数据获取
    stocks = fetch_stock_pool(START_DATE)
    close_df, money_df = fetch_price_data(stocks, START_DATE, END_DATE)
    st_df = fetch_st_matrix(stocks, START_DATE, END_DATE) if EXCLUDE_ST else None

    # 2) 指标计算
    ma20_df, volavg20_df, above_df = compute_indicators(close_df, money_df)

    # 3) 宽度指标
    width_df = calculate_width_indicator(volavg20_df, above_df, st_df)
    if width_df.empty:
        print('未能计算任何宽度指标，请检查时间范围与数据质量。')
        return

    # 4) 辅助指标
    aux_df = calculate_aux_indicators(width_df, above_df, st_df, volavg20_df)

    # 5) 绘图展示
    plot_heatmap(width_df, aux_df)


if __name__ == '__main__':
    main()
