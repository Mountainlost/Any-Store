SHOW_PROGRESS = True         # 是否显示进度条
PROGRESS_MIN_INTERVAL = 0.5  # 无tqdm时，最低刷新间隔（秒）

# 优先使用 tqdm；缺失时回退到轻量打印
try:
    from tqdm.auto import tqdm as _tqdm
    _HAS_TQDM = True
except Exception:
    _tqdm = None
    _HAS_TQDM = False


def progress_iter(iterable, total=None, desc=''):
    """进度条迭代器：优先用 tqdm；缺失时按秒打印轻量进度。"""
    if not SHOW_PROGRESS:
        for item in iterable:
            yield item
        return

    if _HAS_TQDM:
        for item in _tqdm(iterable, total=total, desc=desc):
            yield item
    else:
        if total is None:
            try:
                total = len(iterable)
            except Exception:
                total = None
        count = 0
        last = time.time()
        for item in iterable:
            yield item
            count += 1
            now = time.time()
            if now - last >= PROGRESS_MIN_INTERVAL:
                if total:
                    pct = count / total * 100.0
                    print(f'{desc} 进度: {count}/{total} ({pct:.1f}%)', end='\r')
                else:
                    print(f'{desc} 已处理: {count}', end='\r')
                last = now
        # 完成后补一行
        if total:
            print(f'{desc} 完成: {count}/{total} (100%)')
        else:
            print(f'{desc} 完成: {count}')




