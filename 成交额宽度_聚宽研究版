def ensure_time_column(df):
    """统一时间列为 'time'；支持 'time'/'date'/'datetime'/DatetimeIndex。"""
    if 'time' in df.columns:
        df['time'] = pd.to_datetime(df['time'], errors='coerce')
        return df
    elif 'date' in df.columns:
        df = df.rename(columns={'date': 'time'})
        df['time'] = pd.to_datetime(df['time'], errors='coerce')
        return df
    elif 'datetime' in df.columns:
        df = df.rename(columns={'datetime': 'time'})
        df['time'] = pd.to_datetime(df['time'], errors='coerce')
        return df
    elif isinstance(df.index, pd.DatetimeIndex):
        df = df.reset_index().rename(columns={'index': 'time'})
        df['time'] = pd.to_datetime(df['time'], errors='coerce')
        return df
    else:
        raise KeyError("未找到用于日期的字段，如 'time'、'date' 或 'datetime'。")

def _normalize_end_date(end_date):
    """将 END_DATE=None 转换为今日日期字符串。"""
    if end_date is None:
        return dt.date.today().strftime('%Y-%m-%d')
    if isinstance(end_date, (dt.date, dt.datetime)):
        return end_date.strftime('%Y-%m-%d')
    return str(end_date)


def fetch_stock_pool(start_date):
    """获取 A 股股票池（基于 start_date 查询时点）。"""
    if isinstance(start_date, (dt.date, dt.datetime)):
        sd = start_date.strftime('%Y-%m-%d')
    else:
        sd = str(start_date)
    stocks = list(get_all_securities(types=['stock'], date=sd).index)
    return stocks


def fetch_price_data(stocks, start_date, end_date):
    """获取多股日频后复权收盘价与成交额；返回 pivot 后的 close_df/money_df。"""
    ed = _normalize_end_date(end_date)
    # 优先使用 count+end_date 抓取，减少区间扫描开销
    if USE_COUNT_FETCH:
        trade_days = get_trade_days(start_date=start_date, end_date=ed)
        cnt = len(trade_days)
        price = get_price(
            stocks,
            end_date=ed,
            count=cnt,
            frequency='daily',
            fields=['close', 'money'],
            skip_paused=False,   # 多股请求必须 False 以保证日期对齐
            fq='post',
            panel=False          # 返回扁平表（包含 time、code 及字段列）
        )
    else:
        price = get_price(
            stocks,
            start_date=start_date,
            end_date=ed,
            frequency='daily',
            fields=['close', 'money'],
            skip_paused=False,
            fq='post',
            panel=False
        )

    # 兼容返回格式：panel=False（推荐）走 pivot；历史版本可能 MultiIndex 直接切片。
    if not isinstance(price, pd.DataFrame):
        raise ValueError('get_price 未返回 DataFrame，无法处理。')

    # 统一时间列并 pivot 为日期×股票的矩阵（close、money）
    price = ensure_time_column(price)
    price['time'] = pd.to_datetime(price['time']).dt.normalize()
    if not {'time', 'code', 'close', 'money'}.issubset(set(price.columns)):
        # 兼容历史 MultiIndex 情形
        if isinstance(price.columns, pd.MultiIndex):
            close_df = price['close']
            money_df = price['money']
        else:
            raise ValueError('get_price 返回结构不含 time/code/close/money，无法转换。')
    else:
        close_df = price.pivot(index='time', columns='code', values='close')
        money_df = price.pivot(index='time', columns='code', values='money')

    # 仅保留日期部分作为索引（去掉具体时间）
    close_df.index = pd.to_datetime(close_df.index).normalize()
    money_df.index = pd.to_datetime(money_df.index).normalize()

    return close_df, money_df


def fetch_st_matrix(stocks, start_date, end_date):
    """获取区间内 ST 标记矩阵（索引为日期，列为股票代码）。"""
    ed = _normalize_end_date(end_date)
    st_df = get_extras('is_st', stocks, start_date=start_date, end_date=ed, df=True)
    st_df.index = pd.to_datetime(st_df.index).normalize()
    return st_df


