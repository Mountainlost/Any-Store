# 3. 指标计算（向量化）
# ==============================================================================

def compute_indicators(close_df, money_df):
    """向量化计算 MA20、AvgVolume20 及 Above_MA20。"""
    ma20_df = close_df.rolling(window=MA_PERIOD, min_periods=MA_PERIOD).mean()
    volavg20_df = money_df.rolling(window=VOLUME_AVG_PERIOD, min_periods=VOLUME_AVG_PERIOD).mean()
    above_df = close_df > ma20_df

    return ma20_df, volavg20_df, above_df


# ==============================================================================
# 4. 宽度指标计算
# ==============================================================================

def calculate_width_indicator(volavg20_df, above_df, st_df=None):
    """按 AvgVolume20 等人数分组，计算各组 Above_MA20 百分比（*100）。"""
    # 排名分箱 + np.bincount，替代逐日 qcut/groupby（更快）
    dates = volavg20_df.index
    codes = volavg20_df.columns

    # 预对齐 ST 矩阵，True 表示 ST；取非 ST 参与计算
    if EXCLUDE_ST and st_df is not None:
        st_aligned = st_df.reindex(index=dates, columns=codes).fillna(False)
    else:
        st_aligned = None

    # 有效性掩码：成交额均值非空；若提供 ST 则叠加非 ST
    valid_mask_df = ~volavg20_df.isna()
    if st_aligned is not None:
        valid_mask_df &= (~st_aligned)

    rows = []
    row_dates = []
    for date in progress_iter(dates, total=len(dates), desc='宽度指标计算'):
        vol_row = volavg20_df.loc[date].values
        above_row = above_df.loc[date].values.astype(np.uint8)
        valid = valid_mask_df.loc[date].values

        if not np.any(valid):
            continue

        vol_valid = vol_row[valid]
        above_valid = above_row[valid]
        n = vol_valid.shape[0]
        # 稳定排序生成秩序号 0..n-1
        order = np.argsort(vol_valid, kind='mergesort')
        rank = np.empty(n, dtype=np.int32)
        rank[order] = np.arange(n)

        # 分箱映射到 0..NUM_GROUPS-1（等人数分组）
        group_idx = (rank * NUM_GROUPS) // n
        if REVERSE_GROUPS:
            group_idx = (NUM_GROUPS - 1) - group_idx

        # 每组强势占比：加权 bincount 计算均值（*100）
        sum_above = np.bincount(group_idx, weights=above_valid, minlength=NUM_GROUPS)
        cnt_group = np.bincount(group_idx, minlength=NUM_GROUPS)
        with np.errstate(divide='ignore', invalid='ignore'):
            pct = np.where(cnt_group > 0, (sum_above / cnt_group) * 100.0, 0.0)

        rows.append(pct)
        row_dates.append(pd.to_datetime(date))

    if not rows:
        return pd.DataFrame()

    columns = [f'组{i+1}' for i in range(NUM_GROUPS)]
    width_df = pd.DataFrame(rows, index=row_dates, columns=columns)
    width_df.index.name = '交易日期'
    width_df.sort_index(inplace=True)
    return width_df


# ==============================================================================
# 5. 辅助指标计算（按需每日估值）
# ==============================================================================

def fetch_market_cap_on_date(date, stocks):
    """在指定日期获取多股票总市值（返回 Series[code -> market_cap]）。"""
    date_str = pd.to_datetime(date).strftime('%Y-%m-%d')
    # 仅取必要字段，减少 IO
    q = query(valuation.code, valuation.market_cap).filter(valuation.code.in_(stocks))
    df = get_fundamentals(q, date=date_str)
    if df is None or df.empty:
        return pd.Series(dtype='float64')
    s = pd.Series(df['market_cap'].values, index=df['code'].values)
    return s


def calculate_aux_indicators(width_df, above_df, st_df, volavg20_df):
    """计算小盘热度、大盘热度、大小热度差与市场均值（与 width_df 同索引）。"""
    aux_df = pd.DataFrame(index=width_df.index)
    small_cap_heat = {}
    large_cap_heat = {}
    for date in progress_iter(width_df.index, total=len(width_df.index), desc='辅助指标计算'):
        # 仅针对当日有效样本请求估值，减少查询体量
        valid_mask = ~volavg20_df.loc[date].isna()
        above_series = above_df.loc[date].loc[valid_mask]
        # ST过滤
        if EXCLUDE_ST and st_df is not None and date in st_df.index:
            st_mask = st_df.loc[date]
            keep_codes = st_mask.index[~st_mask.values]
            above_series = above_series.loc[above_series.index.intersection(keep_codes)]

        # 获取当日估值（总市值），按需请求（仅当日有效且非ST的股票）
        active_codes = list(above_series.index)
        mktcap_series = fetch_market_cap_on_date(date, active_codes)
        if mktcap_series.empty:
            small_cap_heat[date] = 0
            large_cap_heat[date] = 0
            continue

        # 对齐仅包含当日有判断的股票
        mktcap_series = mktcap_series.loc[mktcap_series.index.intersection(above_series.index)]
        if mktcap_series.empty:
            small_cap_heat[date] = 0
            large_cap_heat[date] = 0
            continue

        # 小盘热度
        smallest = mktcap_series.nsmallest(SMALL_CAP_COUNT)
        if smallest.empty:
            small_cap_heat[date] = 0
        else:
            sel_above = above_series.loc[smallest.index].astype(bool)
            small_cap_heat[date] = float(sel_above.mean() * 100.0)

        # 大盘热度
        largest = mktcap_series.nlargest(LARGE_CAP_COUNT)
        if largest.empty:
            large_cap_heat[date] = 0
        else:
            sel_above = above_series.loc[largest.index].astype(bool)
            large_cap_heat[date] = float(sel_above.mean() * 100.0)

    aux_df['小盘热度'] = pd.Series(small_cap_heat)
    aux_df['大盘热度'] = pd.Series(large_cap_heat)

    # 大小热度差（组1与组20差值绝对值）
    if '组1' in width_df.columns and '组20' in width_df.columns:
        aux_df['大小热度差'] = (width_df['组1'] - width_df['组20']).abs()
    else:
        aux_df['大小热度差'] = 0

    # 市场均值（所有组的平均值）
    aux_df['市场均值'] = width_df.mean(axis=1)

    return aux_df


